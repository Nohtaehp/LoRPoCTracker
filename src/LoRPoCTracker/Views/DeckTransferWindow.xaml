<Window x:Class="LoRPoCTracker.Views.DeckTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boss 牌库导出 / 导入"
        Icon="pack://siteoforigin:,,,/tools/icons/app.ico"
        Width="920" Height="600"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="单个 Boss 牌库可导出为 *.lorboss.json 单独分发。导出只在「录制模式（管理员版）」且该 Boss 牌库「已归档（定档）」后可用；导入与云源合并普通版 / 录制模式都可用，写入的都是本地录制 data/encounters.json。" />

        <ListView x:Name="DeckList" Grid.Row="1" FontSize="12"
                  ItemContainerStyle="{StaticResource ArchivedRowStyle}"
                  SelectionChanged="DeckList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="战役" Width="150" DisplayMemberBinding="{Binding Campaign}" />
                    <GridViewColumn Header="大地图" Width="120" DisplayMemberBinding="{Binding MapName}" />
                    <GridViewColumn Header="地图节点" Width="160" DisplayMemberBinding="{Binding NodeName}" />
                    <GridViewColumn Header="名称 key" Width="180" DisplayMemberBinding="{Binding BossKey}" />
                    <GridViewColumn Header="种数" Width="50" DisplayMemberBinding="{Binding CardCount}" />
                    <GridViewColumn Header="张数" Width="50" DisplayMemberBinding="{Binding CardTotal}" />
                    <GridViewColumn Header="归档（定档）" Width="90" DisplayMemberBinding="{Binding ArchivedText}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="把网络源整体合并到本地" Style="{StaticResource SectionHeader}" />
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                           Text="只写入云端「已归档」且本地「未归档 / 本地没有」的牌库；本地已归档的牌库不会被云端覆盖，云端未归档的草稿也不会写入。" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ComboBox x:Name="SourceBox" Width="330" DisplayMemberPath="Name" />
                    <Button x:Name="MergeButton" Content="加载并合并到本地…" Width="150" Margin="8,0,0,0"
                            Padding="0,5" Click="Merge_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="ExportHint" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock x:Name="StatusText" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ExportButton" Content="导出选中 Boss…" Width="120" Margin="0,0,8,0"
                    Padding="0,5" Click="Export_Click" />
            <Button x:Name="ImportButton" Content="导入到选中 Boss…" Width="130" Margin="0,0,8,0"
                    Padding="0,5" Click="ImportToSelected_Click" />
            <Button x:Name="ImportFileButton" Content="按文件内的 Boss 导入…" Width="160" Margin="0,0,8,0"
                    Padding="0,5" Click="ImportByFile_Click" />
            <Button Content="关闭" Width="72" Padding="0,5" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
