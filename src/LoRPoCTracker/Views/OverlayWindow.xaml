<Window x:Class="LoRPoCTracker.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LoRPoCTracker.Models"
        Title="LoR 英雄之路记牌器"
        Width="332" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="CardRowTemplate" DataType="{x:Type models:CardRow}">
            <Grid Height="25" Opacity="{Binding RowOpacity}"
                  ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="20000"
                  ToolTipService.ToolTipOpening="CardRow_ToolTipOpening">
                <Grid.ToolTip>
                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             Opened="CardToolTip_Opened" Closed="CardToolTip_Closed">
                        <StackPanel MaxWidth="240">
                            <Image Source="{Binding ImageSource}" Width="220" Stretch="Uniform"
                                   Visibility="{Binding ImageVisibility}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Tooltip}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ToolTip>
                </Grid.ToolTip>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="3" Height="15" CornerRadius="1.5"
                        Background="{Binding RegionBrush}" HorizontalAlignment="Left" />

                <Border Grid.Column="1" Width="19" Height="19" CornerRadius="9.5"
                        Background="{DynamicResource ChipBackgroundBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CostText}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource CostTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <DockPanel Grid.Column="2" Margin="2,0,6,0" VerticalAlignment="Center" LastChildFill="True">
                    <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoftBrush}" CornerRadius="3" Padding="3,0"
                            Margin="4,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="新" FontSize="9" Foreground="{DynamicResource AccentStrongBrush}" />
                    </Border>
                    <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="3" Padding="3,0"
                            Margin="4,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsToken, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="衍生" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <Style x:Key="CardListStyle" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource CardRowTemplate}" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource OverlayBorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖拽） -->
            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown"
                  MouseMove="HeaderBar_MouseMove"
                  MouseLeftButtonUp="HeaderBar_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="英雄之路" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="记牌器" FontSize="13" FontWeight="Bold" Margin="5,0,0,0" />
                    <Border x:Name="VersionBadgeBox" CornerRadius="3" Background="{DynamicResource AccentSoftBrush}"
                            Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="VersionBadge" Text="录制模式" FontSize="9.5"
                                   Foreground="{DynamicResource AccentStrongBrush}"
                                   ToolTip="可在菜单「软件版本」中切换" />
                    </Border>
                    <Border x:Name="ThroughBadge" CornerRadius="3" Background="{DynamicResource AccentSoftBrush}" Padding="4,1"
                            Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="穿透" FontSize="9.5" Foreground="{DynamicResource AccentStrongBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="ResetButton" Style="{StaticResource IconButton}" Content="↻"
                            ToolTip="重置本局记录" Click="ResetButton_Click" Visibility="Collapsed" />
                    <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="≡"
                            ToolTip="菜单" Click="MenuButton_Click" />
                    <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Content="−"
                            ToolTip="最小化到托盘" Click="MinimizeButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="×"
                            ToolTip="退出" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- 状态区 -->
            <Border Grid.Row="1" Margin="10,0,10,6" Padding="9,7" CornerRadius="8" Background="{DynamicResource PanelBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusDetail}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="13,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 牌库 / 对手 / 已见 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="10,0,10,4" Focusable="False">
                <StackPanel>
                    <ToggleButton Content="{Binding DeckTitle}" Style="{StaticResource SectionToggle}"
                                  IsChecked="{Binding IsDeckExpanded, Mode=TwoWay}" />

                    <StackPanel Visibility="{Binding IsDeckExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding DeckRows}" Style="{StaticResource CardListStyle}" />

                        <StackPanel Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVis}}"
                                    Margin="0,2,0,10">
                            <TextBlock Text="{Binding EmptyHint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 本地图 Boss 牌库：进入大地图后显示该地图已录入的所有 Boss（带头像） -->
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,10"
                            Visibility="{Binding ShowMapBossSection, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Visibility="{Binding ShowMapBossSection, Converter={StaticResource BoolToVis}}">
                        <ToggleButton Content="{Binding MapBossTitle}" Style="{StaticResource SectionToggle}"
                                      IsChecked="{Binding IsMapBossExpanded, Mode=TwoWay}" />
                        <StackPanel Visibility="{Binding IsMapBossExpanded, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding MapBossSubtitle}" FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding MapBossEmptyHint}" FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="2,2,0,4"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding MapBossEmptyHintVisibility}" />

                            <ItemsControl ItemsSource="{Binding MapBossRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:MapBossRow}">
                                        <StackPanel Margin="0,0,0,2">
                                            <Border CornerRadius="6" Padding="2,1"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="MapBossRow_MouseLeftButtonUp"
                                                    MouseRightButtonUp="MapBossRow_MouseRightButtonUp"
                                                    ToolTip="点击展开/收起该 Boss 的牌库">
                                                <!-- 已归档（定档）的 Boss 行背景稍微区分 -->
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFinalized}" Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource ArchivedRowBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid Height="30">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Boss 头像：与游戏地图节点同源的插画裁切 -->
                                                    <Grid Width="26" Height="26" HorizontalAlignment="Left"
                                                          VerticalAlignment="Center">
                                                        <Ellipse Fill="{Binding AvatarBrush}" Opacity="0.9" />
                                                        <Ellipse Visibility="{Binding AvatarVisibility}">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding Avatar}"
                                                                            Stretch="UniformToFill" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Initial}"
                                                                   Visibility="{Binding InitialVisibility}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,4,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ExpandGlyph}" FontSize="9"
                                                                       VerticalAlignment="Center" Margin="0,0,3,0"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Border Background="{DynamicResource AccentSoftBrush}"
                                                                    CornerRadius="3" Padding="3,0" Margin="4,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding BadgeVisibility}">
                                                                <TextBlock Text="{Binding Badge}" FontSize="9"
                                                                           Foreground="{DynamicResource AccentStrongBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Detail}" FontSize="9.5"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Grid>
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Cards}"
                                                          ItemTemplate="{StaticResource CardRowTemplate}"
                                                          Margin="22,1,0,3"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,10"
                            Visibility="{Binding ShowBossSection, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Visibility="{Binding ShowBossSection, Converter={StaticResource BoolToVis}}">
                        <ToggleButton Content="{Binding BossTitle}" Style="{StaticResource SectionToggle}"
                                      Foreground="{DynamicResource AccentBrush}"
                                      IsChecked="{Binding IsBossExpanded, Mode=TwoWay}" />
                        <StackPanel Visibility="{Binding IsBossExpanded, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BossSubtitle}" FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding BossRows}" Style="{StaticResource CardListStyle}"
                                          Visibility="{Binding HasBossRows, Converter={StaticResource BoolToVis}}"
                                          MouseRightButtonUp="BossRows_MouseRightButtonUp" />
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,10"
                            Visibility="{Binding HasOpponentRows, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Visibility="{Binding HasOpponentRows, Converter={StaticResource BoolToVis}}">
                        <ToggleButton Content="{Binding OpponentTitle}" Style="{StaticResource SectionToggle}"
                                      Foreground="{DynamicResource DangerBrush}"
                                      IsChecked="{Binding IsOpponentExpanded, Mode=TwoWay}" />
                        <ItemsControl ItemsSource="{Binding OpponentRows}" Style="{StaticResource CardListStyle}"
                                      Visibility="{Binding IsOpponentExpanded, Converter={StaticResource BoolToVis}}"
                                      MouseRightButtonUp="OpponentRows_MouseRightButtonUp" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasSeenRows, Converter={StaticResource BoolToVis}}">
                        <ToggleButton Content="{Binding SeenTitle}" Style="{StaticResource SectionToggle}"
                                      IsChecked="{Binding IsSeenExpanded, Mode=TwoWay}" />
                        <ItemsControl ItemsSource="{Binding SeenRows}" Style="{StaticResource CardListStyle}"
                                      Visibility="{Binding IsSeenExpanded, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部提示 -->
            <Grid Grid.Row="3" Margin="12,0,12,0">
                <TextBlock x:Name="HintText" Text="Ctrl+Shift+O 穿透 · 拖动标题栏移动"
                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
