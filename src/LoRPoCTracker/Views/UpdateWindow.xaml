<Window x:Class="LoRPoCTracker.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件更新"
        Icon="pack://siteoforigin:,,,/tools/icons/app.ico"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Text="发现新版本" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}" />
            <TextBlock x:Name="SubText" Margin="0,6,0,0" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="12" CornerRadius="8"
                Background="{DynamicResource PanelBrush}">
            <StackPanel>
                <TextBlock Text="更新内容" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBlock x:Name="NotesText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="Progress" Height="6" Margin="0,8,0,0" IsIndeterminate="False" Minimum="0" Maximum="100" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="LaterButton" Content="稍后" Width="88" Padding="0,6" Margin="0,0,8,0"
                    Click="Later_Click" />
            <Button x:Name="ManualButton" Content="打开下载页" Width="110" Padding="0,6" Margin="0,0,8,0"
                    Click="Manual_Click" />
            <Button x:Name="UpdateButton" Content="下载并安装" Width="110" Padding="0,6"
                    Click="Update_Click" />
        </StackPanel>
    </Grid>
</Window>
