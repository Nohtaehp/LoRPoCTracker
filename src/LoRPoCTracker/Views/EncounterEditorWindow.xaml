<Window x:Class="LoRPoCTracker.Views.EncounterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关卡录制管理"
        Icon="pack://siteoforigin:,,,/tools/icons/app.ico"
        Width="880" Height="520"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="按「战役 → 大地图」分组，点击标题可收起/展开；大地图只显示该战役拥有的地图；选中一行可编辑其牌库；「预定」用于和录制张数对比；「定档牌库」后该关卡不再自动录制，但仍可手动编辑"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                   TextWrapping="Wrap" />

        <ListView x:Name="RecordList" Grid.Row="1" FontSize="12"
                  ItemContainerStyle="{StaticResource ArchivedRowStyle}"
                  SelectionChanged="RecordList_SelectionChanged">
            <ListView.GroupStyle>
                <!-- 一级：战役 -->
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <StackPanel Margin="0,2,0,4">
                                            <ToggleButton x:Name="Header" IsChecked="True" Margin="0,0,0,2"
                                                          Style="{StaticResource SectionToggle}"
                                                          FontSize="12.5"
                                                          Foreground="{DynamicResource TextPrimaryBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Name}" Value="">
                                                                        <Setter Property="Text" Value="未分类" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat=（{0} 个地图）}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="4,0,0,0" />
                                                </StackPanel>
                                            </ToggleButton>

                                            <ItemsPresenter x:Name="Items">
                                                <ItemsPresenter.Style>
                                                    <Style TargetType="ItemsPresenter">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=Header}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsPresenter.Style>
                                            </ItemsPresenter>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>

                <!-- 二级：大地图 -->
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <StackPanel Margin="16,0,0,3">
                                            <ToggleButton x:Name="Header" IsChecked="True" Margin="0,0,0,1"
                                                          Style="{StaticResource SectionToggle}"
                                                          FontSize="11">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Name}" Value="">
                                                                        <Setter Property="Text" Value="未分类" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat=（{0}）}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="4,0,0,0" />
                                                </StackPanel>
                                            </ToggleButton>

                                            <ItemsPresenter x:Name="Items">
                                                <ItemsPresenter.Style>
                                                    <Style TargetType="ItemsPresenter">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=Header}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsPresenter.Style>
                                            </ItemsPresenter>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListView.GroupStyle>

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="战役（可下拉选择）" Width="165">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Width="149" IsEditable="True"
                                          ItemsSource="{Binding CampaignOptions}"
                                          Text="{Binding Campaign, UpdateSourceTrigger=LostFocus}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="大地图（该战役可选）" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Width="124" IsEditable="True"
                                          ItemsSource="{Binding MapOptions}"
                                          Text="{Binding MapName, UpdateSourceTrigger=LostFocus}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="地图节点" Width="135"
                                    DisplayMemberBinding="{Binding NodeName}" />
                    <GridViewColumn Header="名称 key" Width="175">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BossKey}" ToolTip="{Binding Key}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="张数" Width="50"
                                    DisplayMemberBinding="{Binding CardTotal}" />
                    <GridViewColumn Header="预定" Width="62">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Width="48" Padding="2,1"
                                         Text="{Binding ExpectedCount, UpdateSourceTrigger=LostFocus}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="已录制" Width="55"
                                    DisplayMemberBinding="{Binding CardCount}" />
                    <GridViewColumn Header="定档" Width="60"
                                    DisplayMemberBinding="{Binding FinalizedText}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="编辑牌库…" Width="96" Margin="0,0,8,0" Padding="0,5" Click="EditDeck_Click" />
            <Button x:Name="FinalizeButton" Content="定档牌库" Width="96" Margin="0,0,8,0" Padding="0,5"
                    Click="Finalize_Click" />
            <Button Content="保存名称" Width="96" Margin="0,0,8,0" Padding="0,5" Click="Save_Click" />
            <Button Content="删除选中" Width="96" Margin="0,0,8,0" Padding="0,5" Click="Delete_Click" />
            <Button Content="关闭" Width="72" Padding="0,5" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
