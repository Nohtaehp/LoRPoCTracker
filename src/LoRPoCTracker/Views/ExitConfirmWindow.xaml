<Window x:Class="LoRPoCTracker.Views.ExitConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="退出记牌器"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="18,16">
        <TextBlock Text="确定要退出记牌器吗？" FontSize="14" FontWeight="SemiBold" />
        <TextBlock Text="退出后本局记录会立即保存，之后将停止记录。"
                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,5,0,0" TextWrapping="Wrap" />
        <CheckBox x:Name="DontAskBox" Content="下次不再提示" Margin="0,14,0,0" FontSize="12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="退出" Width="80" Height="28" Margin="0,0,8,0" Click="Exit_Click" />
            <Button Content="取消" Width="72" Height="28" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
