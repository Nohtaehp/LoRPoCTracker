<Window x:Class="LoRPoCTracker.Views.SourceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="牌库数据源"
        Width="760" Height="480"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="本地源固定为 data/encounters.json，是唯一可录制 / 编辑的源；网络源只读，可添加任意 jsDelivr、GitHub raw 或自建 http(s) 直链。一个源可填多个文件地址（每行一个），加载时按「卡牌取最大张数、定档取并集」合并。下载结果会缓存在本地，断网时自动使用缓存。" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="SourceList" Grid.Column="0" FontSize="12"
                      SelectionChanged="SourceList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="数据源" Width="150" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="类型" Width="90" DisplayMemberBinding="{Binding Summary}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="名称" FontSize="12" />
                <TextBox x:Name="NameBox" Margin="0,3,0,8" Padding="3,2" />

                <TextBlock Text="录制文件地址（每行一个，支持多文件）" FontSize="12" />
                <TextBox x:Name="FilesBox" Height="170" Margin="0,3,0,6" Padding="3,2"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="GitHub：https://raw.githubusercontent.com/用户/仓库/main/data/encounters.json" />
                <TextBlock FontSize="10.5" Margin="0,2,0,6" Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Text="jsDelivr：https://cdn.jsdelivr.net/gh/用户/仓库@main/data/encounters.json" />

                <TextBlock x:Name="HintText" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="保存修改" Width="96" Margin="0,0,8,0" Padding="0,5" Click="Save_Click" />
                    <Button Content="设为当前源" Width="96" Margin="0,0,8,0" Padding="0,5" Click="Activate_Click" />
                    <Button Content="清缓存并刷新" Width="106" Padding="0,5" Click="Refresh_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="添加网络源" Width="100" Margin="0,0,8,0" Padding="0,5" Click="Add_Click" />
            <Button Content="删除选中" Width="90" Margin="0,0,8,0" Padding="0,5" Click="Delete_Click" />
            <Button Content="关闭" Width="72" Padding="0,5" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
