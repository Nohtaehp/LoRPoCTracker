<Window x:Class="LoRPoCTracker.Views.CardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑 Boss 牌库"
        Icon="pack://siteoforigin:,,,/tools/icons/app.ico"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
            <!-- Boss 头像：与游戏地图节点同源的插画裁切 -->
            <Grid Width="56" Height="56" Margin="0,2,10,0" VerticalAlignment="Top">
                <Ellipse x:Name="BossAvatarCircle" Fill="{DynamicResource ChipBackgroundBrush}" />
                <Ellipse x:Name="BossAvatarEllipse" Visibility="Collapsed" />
                <TextBlock x:Name="BossAvatarInitial" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <StackPanel>
                <TextBlock Text="编辑 Boss 牌库" FontSize="15" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock x:Name="TitleText" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="SummaryText" FontSize="12" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="预定张数" FontSize="12" VerticalAlignment="Center" />
                    <TextBox x:Name="ExpectedBox" Width="58" Margin="6,0,0,0" Padding="3,2"
                             TextChanged="ExpectedBox_TextChanged" />
                    <TextBlock x:Name="ExpectedHint" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="可以直接增删卡牌、修改数量；预定张数用于和实际录制张数对比（对手会丢牌，打完可能对不上）。诅咒等衍生卡不写入牌库，武器反复打出只按 1 张实体计；保存后立即影响剩余牌库计算。"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <ListView x:Name="DeckList" Grid.Row="1" FontSize="12" SelectionChanged="DeckList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="费" Width="40" DisplayMemberBinding="{Binding CostText}" />
                    <GridViewColumn Header="卡牌" Width="360">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="15" CornerRadius="1.5" Margin="0,0,6,0"
                                            Background="{Binding RegionBrush}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="3"
                                            Padding="3,0" Margin="6,0,0,0"
                                            Visibility="{Binding IsToken, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="衍生" FontSize="9"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="数量" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                         Width="56" Padding="3,2" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="删除" Width="54" Padding="0,2"
                                        Tag="{Binding Code}" Click="DeleteRow_Click" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="8"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="添加卡牌" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchBox" Width="300" Padding="4,3" KeyDown="SearchBox_KeyDown" />
                    <Button Content="搜索" Width="60" Margin="6,0,0,0" Padding="0,3" Click="Search_Click" />
                    <TextBox x:Name="AddCountBox" Width="46" Margin="10,0,0,0" Padding="4,3" Text="1" />
                    <Button Content="添加选中" Width="80" Margin="6,0,0,0" Padding="0,3" Click="Add_Click" />
                </StackPanel>
                <ListBox x:Name="SearchResults" Height="100" Margin="0,6,0,0"
                         FontSize="12" MouseDoubleClick="SearchResults_MouseDoubleClick"
                         SelectionChanged="SearchResults_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="14" CornerRadius="1.5" Margin="0,0,6,0"
                                        Background="{Binding RegionBrush}" />
                                <TextBlock Text="{Binding Name}" Width="300" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="费 " Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding CostText}" Width="24" />
                                <TextBlock Text="{Binding Code}" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Margin="12,0,0,0" Padding="8"
                VerticalAlignment="Top"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <StackPanel>
                <Image x:Name="PreviewImage" Width="176" Stretch="Uniform" HorizontalAlignment="Center" />
                <TextBlock x:Name="PreviewName" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PreviewHint" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="选中卡牌后在这里显示图片" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存并关闭" Width="110" Padding="0,5" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="取消" Width="72" Padding="0,5" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
